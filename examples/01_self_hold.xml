<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-Hold Circuit (自己保持回路)
  ================================
  The most fundamental PLC pattern. Press START (X001) while SAFETY (X002)
  is confirmed to latch output Y001 ON. It stays ON even after releasing
  the button because Y001 feeds back as a parallel branch (seal-in).
  Press STOP (X003) to reset.

  Ladder diagram:
    |--[X001]--[X002]--+---------(Y001)|
    |                  |               |
    |--[Y001]---------+               |
    |                                  |
    |--[X003]---------------------(RST)|

  Logic:  Y001 = (X001 AND X002) OR Y001
  Reset:  X003 -> Reset Y001
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="LadderMD Examples" productName="" productVersion="" creationDateTime="2024-01-01T00:00:00"/>
  <contentHeader name="SelfHoldCircuit" modificationDateTime="2024-01-01T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="X001"><type><BOOL/></type></variable>
            <variable name="X002"><type><BOOL/></type></variable>
            <variable name="X003"><type><BOOL/></type></variable>
            <variable name="Y001"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Rung 1: Self-hold (latch) -->
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="40"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="2" negated="false">
              <position x="80" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <contact localId="3" negated="false">
              <position x="160" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X002</variable>
            </contact>

            <contact localId="4" negated="false">
              <position x="80" y="40"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1" formalParameter=""/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </contact>

            <coil localId="5" negated="false">
              <position x="320" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="3"/>
                <connection refLocalId="4"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>

            <!-- Rung 2: Reset -->
            <leftPowerRail localId="6">
              <position x="0" y="100"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="7" negated="false">
              <position x="80" y="100"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="6"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X003</variable>
            </contact>

            <coil localId="8" negated="false" storage="reset">
              <position x="320" y="100"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="7"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Res">
          <task name="Main" priority="0" interval="T#20ms">
            <pouInstance name="Main" typeName="Main"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
