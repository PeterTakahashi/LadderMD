<?xml version="1.0" encoding="UTF-8"?>
<!--
  Emergency Stop Circuit (非常停止回路)
  ======================================
  Safety-first design using a NC (normally closed / b-contact) for
  the emergency stop button X010. In normal operation X010 is closed
  (current flows). When pressed, X010 opens and immediately kills Y001.

  Combined with a self-hold: press START (X001) to latch Y001 ON,
  but only while the e-stop is not pressed.

  Ladder diagram:
    |--[/X010]--[X001]--+---------(Y001)|
    |                   |               |
    |---[Y001]---------+               |

  Logic:  Y001 = NOT X010 AND (X001 OR Y001)

  Why NC for e-stop? If the wire breaks, the contact opens just like
  pressing the button — the system fails safe (stops).
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="LadderMD Examples" productName="" productVersion="" creationDateTime="2024-01-01T00:00:00"/>
  <contentHeader name="EmergencyStopCircuit" modificationDateTime="2024-01-01T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="X010"><type><BOOL/></type></variable>
            <variable name="X001"><type><BOOL/></type></variable>
            <variable name="Y001"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <!-- X010: NC contact (emergency stop) -->
            <contact localId="2" negated="true">
              <position x="80" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X010</variable>
            </contact>

            <!-- X001: NO contact (start button) -->
            <contact localId="3" negated="false">
              <position x="160" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <!-- Y001: self-hold branch -->
            <contact localId="4" negated="false">
              <position x="160" y="40"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </contact>

            <!-- Y001: output coil -->
            <coil localId="5" negated="false">
              <position x="320" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="3"/>
                <connection refLocalId="4"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Res">
          <task name="Main" priority="0" interval="T#20ms">
            <pouInstance name="Main" typeName="Main"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
