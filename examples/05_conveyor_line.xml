<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conveyor Line Control (コンベアライン制御)
  ==========================================
  A more realistic example combining multiple patterns:

  Rung 1: Motor start with safety interlock
    - Emergency stop (X010, NC) must be closed
    - Start button (X001) latches motor (Y001) ON
    - Self-hold keeps it running

  Rung 2: Stop button resets motor
    - Stop button (X002) resets Y001

  Rung 3: Warning light
    - When motor Y001 is running AND sensor X003 detects product,
      turn on warning light Y002

  Ladder diagram:
    Rung 1:
    |--[/X010]--[X001]--+---------(Y001)|
    |                   |               |
    |---[Y001]---------+               |
    Rung 2:
    |--[X002]---------------------(R Y001)|
    Rung 3:
    |--[Y001]--[X003]-------------(Y002)|
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="LadderMD Examples" productName="" productVersion="" creationDateTime="2024-01-01T00:00:00"/>
  <contentHeader name="ConveyorLineControl" modificationDateTime="2024-01-01T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="X010"><type><BOOL/></type></variable>
            <variable name="X001"><type><BOOL/></type></variable>
            <variable name="X002"><type><BOOL/></type></variable>
            <variable name="X003"><type><BOOL/></type></variable>
            <variable name="Y001"><type><BOOL/></type></variable>
            <variable name="Y002"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Rung 1: Motor start with e-stop and self-hold -->
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="2" negated="true">
              <position x="80" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X010</variable>
            </contact>

            <contact localId="3" negated="false">
              <position x="160" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <contact localId="4" negated="false">
              <position x="160" y="40"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </contact>

            <coil localId="5" negated="false">
              <position x="320" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="3"/>
                <connection refLocalId="4"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>

            <!-- Rung 2: Stop button resets motor -->
            <leftPowerRail localId="6">
              <position x="0" y="100"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="7" negated="false">
              <position x="80" y="100"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="6"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X002</variable>
            </contact>

            <coil localId="8" negated="false" storage="reset">
              <position x="320" y="100"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="7"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>

            <!-- Rung 3: Warning light when motor + sensor -->
            <leftPowerRail localId="9">
              <position x="0" y="160"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="10" negated="false">
              <position x="80" y="160"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="9"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </contact>

            <contact localId="11" negated="false">
              <position x="160" y="160"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="10"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X003</variable>
            </contact>

            <coil localId="12" negated="false">
              <position x="320" y="160"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="11"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y002</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Res">
          <task name="Main" priority="0" interval="T#20ms">
            <pouInstance name="Main" typeName="Main"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
