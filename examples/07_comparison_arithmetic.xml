<?xml version="1.0" encoding="UTF-8"?>
<!--
  Comparison & Arithmetic Circuit (比較演算・算術演算回路)
  ========================================================
  Demonstrates GT (Greater Than), ADD, and EQ (Equal) blocks.

  Rung 1: If X001 is ON and TempSensor > Threshold (GT), turn on alarm Y001
  Rung 2: If X001 is ON, compute ADD(IN1, IN2) -> enable Y002
  Rung 3: EQ block (standalone comparison)

  Supported block types:
    Comparison: GT, GE, EQ, LE, LT, NE
    Arithmetic: ADD, SUB, MUL, DIV, MOD
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="LadderMD Examples" productName="" productVersion="" creationDateTime="2024-01-01T00:00:00"/>
  <contentHeader name="ComparisonArithmetic" modificationDateTime="2024-01-01T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="X001"><type><BOOL/></type></variable>
            <variable name="TempSensor"><type><INT/></type></variable>
            <variable name="Threshold"><type><INT/></type></variable>
            <variable name="Y001"><type><BOOL/></type></variable>
            <variable name="Y002"><type><BOOL/></type></variable>
            <variable name="SumResult"><type><INT/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Rung 1: GT comparison -> alarm -->
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="2" negated="false">
              <position x="80" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <block localId="3" typeName="GT">
              <position x="200" y="0"/>
              <inputVariables>
                <variable formalParameter="IN1">
                  <connectionPointIn>
                    <relPosition x="0" y="0"/>
                    <connection refLocalId="2"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="IN2">
                  <connectionPointIn>
                    <relPosition x="0" y="20"/>
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="OUT">
                  <connectionPointOut>
                    <relPosition x="80" y="0"/>
                  </connectionPointOut>
                </variable>
              </outputVariables>
            </block>

            <coil localId="4" negated="false">
              <position x="360" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="3"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>

            <!-- Rung 2: ADD arithmetic -->
            <leftPowerRail localId="5">
              <position x="0" y="80"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="6" negated="false">
              <position x="80" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="5"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <block localId="7" typeName="ADD">
              <position x="200" y="80"/>
              <inputVariables>
                <variable formalParameter="IN1">
                  <connectionPointIn>
                    <relPosition x="0" y="0"/>
                    <connection refLocalId="6"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="IN2">
                  <connectionPointIn>
                    <relPosition x="0" y="20"/>
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="OUT">
                  <connectionPointOut>
                    <relPosition x="80" y="0"/>
                  </connectionPointOut>
                </variable>
              </outputVariables>
            </block>

            <coil localId="8" negated="false">
              <position x="360" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="7"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y002</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Res">
          <task name="Main" priority="0" interval="T#20ms">
            <pouInstance name="Main" typeName="Main"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
