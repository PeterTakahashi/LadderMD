<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="" productName="" productVersion="" creationDateTime="2024-01-01T00:00:00"/>
  <contentHeader name="CounterTest" modificationDateTime="2024-01-01T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="X001"><type><BOOL/></type></variable>
            <variable name="X002"><type><BOOL/></type></variable>
            <variable name="X003"><type><BOOL/></type></variable>
            <variable name="Y001"><type><BOOL/></type></variable>
            <variable name="Y002"><type><BOOL/></type></variable>
            <variable name="CTU1">
              <type><derived name="CTU"/></type>
            </variable>
            <variable name="CTD1">
              <type><derived name="CTD"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Rung 1: CTU (Count Up) block -->
            <!-- X001 pulses count up, X002 resets the counter -->
            <!-- When CV >= PV (preset=5), Q turns ON -> Y001 -->
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="2" negated="false">
              <position x="80" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <block localId="3" typeName="CTU" instanceName="CTU1">
              <position x="200" y="0"/>
              <inputVariables>
                <variable formalParameter="CU">
                  <connectionPointIn>
                    <relPosition x="0" y="0"/>
                    <connection refLocalId="2"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="RESET">
                  <connectionPointIn>
                    <relPosition x="0" y="20"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="PV">
                  <connectionPointIn>
                    <relPosition x="0" y="40"/>
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q">
                  <connectionPointOut>
                    <relPosition x="80" y="0"/>
                  </connectionPointOut>
                </variable>
                <variable formalParameter="CV">
                  <connectionPointOut>
                    <relPosition x="80" y="20"/>
                  </connectionPointOut>
                </variable>
              </outputVariables>
            </block>

            <!-- Rung 2: CTU1.Q -> Y001 -->
            <leftPowerRail localId="4">
              <position x="0" y="80"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="5" negated="false">
              <position x="80" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="4"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </contact>

            <coil localId="6" negated="false">
              <position x="320" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="5"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>

            <!-- Rung 3: CTD (Count Down) block -->
            <!-- X003 pulses count down from preset=10 -->
            <!-- When CV <= 0, Q turns ON -> Y002 -->
            <leftPowerRail localId="7">
              <position x="0" y="160"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="8" negated="false">
              <position x="80" y="160"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="7"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X003</variable>
            </contact>

            <block localId="9" typeName="CTD" instanceName="CTD1">
              <position x="200" y="160"/>
              <inputVariables>
                <variable formalParameter="CD">
                  <connectionPointIn>
                    <relPosition x="0" y="0"/>
                    <connection refLocalId="8"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="LOAD">
                  <connectionPointIn>
                    <relPosition x="0" y="20"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="PV">
                  <connectionPointIn>
                    <relPosition x="0" y="40"/>
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q">
                  <connectionPointOut>
                    <relPosition x="80" y="0"/>
                  </connectionPointOut>
                </variable>
                <variable formalParameter="CV">
                  <connectionPointOut>
                    <relPosition x="80" y="20"/>
                  </connectionPointOut>
                </variable>
              </outputVariables>
            </block>

            <!-- Rung 4: CTD1.Q -> Y002 -->
            <leftPowerRail localId="10">
              <position x="0" y="240"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <contact localId="11" negated="false">
              <position x="80" y="240"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="10"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y002</variable>
            </contact>

            <coil localId="12" negated="false">
              <position x="320" y="240"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="11"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y002</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Res">
          <task name="Main" priority="0" interval="T#20ms">
            <pouInstance name="Main" typeName="Main"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
