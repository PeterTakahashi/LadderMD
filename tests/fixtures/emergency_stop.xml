<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="" productName="" productVersion="" creationDateTime="2024-01-01T00:00:00"/>
  <contentHeader name="EmergencyStopTest" modificationDateTime="2024-01-01T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="X010"><type><BOOL/></type></variable>
            <variable name="X001"><type><BOOL/></type></variable>
            <variable name="Y001"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Rung 1: Y001 = NOT X010 AND (X001 OR Y001) -->
            <!-- Emergency stop (X010) is NC (normally closed / b-contact) -->
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter="">
                <relPosition x="0" y="0"/>
              </connectionPointOut>
            </leftPowerRail>

            <!-- X010 b-contact (NC) - emergency stop -->
            <contact localId="2" negated="true">
              <position x="80" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X010</variable>
            </contact>

            <!-- X001 contact (NO) - start button -->
            <contact localId="3" negated="false">
              <position x="160" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>X001</variable>
            </contact>

            <!-- Y001 contact (NO) - self-hold branch -->
            <contact localId="4" negated="false">
              <position x="160" y="40"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="2"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </contact>

            <!-- Y001 coil -->
            <coil localId="5" negated="false">
              <position x="320" y="0"/>
              <connectionPointIn>
                <relPosition x="0" y="0"/>
                <connection refLocalId="3"/>
                <connection refLocalId="4"/>
              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config">
        <resource name="Res">
          <task name="Main" priority="0" interval="T#20ms">
            <pouInstance name="Main" typeName="Main"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
