              </connectionPointIn>
              <connectionPointOut>
                <relPosition x="60" y="0"/>
              </connectionPointOut>
              <variable>Y001</variable>
            </coil>

            <!-- Rung 2: Reset by X003 -->
            <leftPowerRail localId="6">
              <position x="0" y="100"/>
